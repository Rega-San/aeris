server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    # DNS Docker ; la résolution différée permet aussi le lancement du TP1 seul.
    resolver 127.0.0.11 valid=10s ipv6=off;
    location /api/ {
        set $api_upstream ${BACKEND_UPSTREAM};
        proxy_pass http://$api_upstream$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 25s;
        proxy_intercept_errors off;
        error_page 502 503 504 = @api_unavailable;
    }
    location @api_unavailable {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        return 503 '{"error":"Le service est temporairement indisponible. Réessayez."}';
    }
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }
    location /_next/static/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }
    location / {
        try_files $uri $uri.html $uri/ =404;
    }
    error_page 404 /404.html;
}
