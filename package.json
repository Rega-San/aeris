{
  "name": "aeris-weather-app",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "npm --prefix frontend ci && npm --prefix backend ci",
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "typecheck": "npm --prefix backend run typecheck && npm --prefix frontend run typecheck",
    "lint": "npm --prefix frontend run lint",
    "test": "npm --prefix backend test",
    "test:e2e": "npm --prefix frontend run test:e2e",
    "test:live": "npm --prefix frontend run test:live",
    "test:api": "node scripts/check-api.mjs",
    "test:stack": "node scripts/check-stack.mjs"
  }
}
